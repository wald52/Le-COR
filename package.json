{
  "name": "le-cor-citoyen",
  "version": "1.2.0",
  "private": true,
  "description": "Outil citoyen de visualisation des hypothèses du Conseil d'orientation des retraites (COR). Site statique, sans dépendance d'exécution.",
  "homepage": "https://wald52.github.io/Le-COR/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check \"{js,data}/**/*.js\" \"*.html\" \"css/**/*.css\"",
    "format:fix": "prettier --write \"{js,data}/**/*.js\" \"*.html\" \"css/**/*.css\"",
    "serve": "python3 -m http.server 8000",
    "build:min": "node tools/minify-assets.mjs && node tools/stamp-assets.mjs",
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5"
  }
}
